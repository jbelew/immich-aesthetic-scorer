# Immich Connection Settings
IMMICH_URL=http://192.168.0.23:2283
IMMICH_API_KEY=your-immich-api-key-here

# Source Selection (Provide one of these or let CLI prompt you)
PERSON_ID=uuid-of-person-from-immich-facial-db-optional
ALBUM_ID=uuid-of-source-album-to-process-optional

# Scoring Method
# Supported options: local, gemini, openai
SCORER_TYPE=local

# Local Scorer Options (CLIP)
LOCAL_MODEL_ID=rsinema/aesthetic-scorer

# Google Gemini Scorer Options
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / Ollama Scorer Options
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Two-Stage Pipeline Configuration
TWO_STAGE=true
STAGE2_TOP_PCT=15.0
STAGE2_MODEL=gemini-2.5-flash
STAGE2_WEIGHT=0.5

# Compilation & Syncing Properties
TARGET_ALBUM_NAME=Highlights Album Name
LIMIT=100
CONCURRENCY=15
DELAY=0.0
WRITE_RATINGS=true
DEDUP_WINDOW=120
CACHE_FILE=.immich_aesthetic_cache.json
